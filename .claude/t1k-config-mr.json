{
  "registryVersion": 1,
  "kitName": "theonekit-model-router",
  "modelRouter": {
    "enabled": true,
    "mode": "transparent",
    "defaultBuiltInModel": "sonnet",
    "modelMapping": {
      "claude-sonnet-4-6": {
        "provider": "opencode-go",
        "model": "gpt-5.6-luna"
      },
      "claude-haiku-4-5-20251001": {
        "provider": "kimi",
        "model": "kimi-k2.5"
      }
    },
    "excludeAgents": [
      "t1k-web-testing-tester",
      "t1k-project-manager",
      "t1k-docs-manager",
      "t1k-git-manager"
    ],
    "perSpawnModelOverride": true,
    "security": {
      "allowedProviders": [
        "kimi",
        "opencode-go",
        "codex"
      ],
      "dataClassification": {
        "enabled": true,
        "blockClasses": [
          "private-key",
          "aws-key",
          "github-token",
          "api-key",
          "credential",
          "pii"
        ]
      }
    },
    "failover": {
      "enabled": true,
      "perHopTimeoutSec": 240,
      "pipe": [
        {
          "provider": "opencode-go",
          "model": "gpt-5.6-luna"
        },
        {
          "provider": "kimi",
          "model": "kimi-k2.7-code"
        }
      ],
      "chain": {
        "opencode-go": "kimi",
        "kimi": "opencode-go",
        "codex": "kimi"
      },
      "fallbackToAnthropic": true,
      "circuitBreaker": {
        "enabled": true,
        "failureThreshold": 3,
        "cooldownSec": 300
      },
      "inHopRetry": {
        "enabled": true,
        "maxRetries": 1,
        "baseDelayMs": 1500
      }
    }
  },
  "_origin": {
    "kit": "theonekit-model-router",
    "repository": "The1Studio/theonekit-model-router",
    "module": null,
    "protected": false
  }
}
