# Copy sang .env rồi điền giá trị thật. .env KHÔNG được commit.
# Tất cả biến dưới đây đều có default (giá trị ghi sẵn chính là default).

# Port công khai — chỉ mang /ws/session/{id}, ra tới trình duyệt.
PUBLIC_ADDR=:8082

# Port nội bộ — /healthz + /metrics. KHÔNG expose ra ingress: /metrics không có
# authz và lộ version + số goroutine (đếm được session đang chạy).
ADMIN_ADDR=127.0.0.1:8083

LOG_LEVEL=info
SHUTDOWN_GRACE=15s

# Chưa dùng ở P0 — gateway chưa gọi orchestrator.
ORCHESTRATOR_GRPC_ADDR=localhost:9090
