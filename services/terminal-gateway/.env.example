# services/terminal-gateway — biến môi trường cho DEV LOCAL.
#
# Cách dùng:  cp services/terminal-gateway/.env.example services/terminal-gateway/.env
#
# Go KHÔNG tự nạp .env (xem services/orchestrator/.env.example). Chạy local bằng:
#   make run-gateway
#
# Mọi biến dưới đây đều CÓ default trong code — giá trị ghi sẵn ở đây chính là
# default đó. Gateway ở P0 chưa nối tới dịch vụ nào nên không có biến bắt buộc.

# ============================================================ Địa chỉ lắng nghe

# Port CÔNG KHAI — chỉ mang /ws/session/{id}, ra tới trình duyệt.
PUBLIC_ADDR=:8082

# Port NỘI BỘ — /healthz + /metrics. KHÔNG expose ra ingress: /metrics không có
# authz và lộ version (tra CVE) + số goroutine (đếm được số session đang chạy).
#
# Trong k8s phải đè thành ":8083" (Helm values đã làm sẵn): default loopback ở
# đây chỉ đúng cho máy dev; trong container nó chặn kubelet probe đánh vào pod IP.
ADMIN_ADDR=127.0.0.1:8083

# ============================================================ Vận hành

LOG_LEVEL=info
SHUTDOWN_GRACE=15s

# ============================================================ Dịch vụ nội bộ

# Chưa dùng ở P0 — gateway chưa gọi orchestrator (task 22). Seam đã khoá từ đây
# để P1 không phải đổi hình dạng config.
ORCHESTRATOR_GRPC_ADDR=localhost:9090
