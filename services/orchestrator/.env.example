# services/orchestrator — biến môi trường cho DEV LOCAL.
#
# Cách dùng:  cp services/orchestrator/.env.example services/orchestrator/.env
#
# LƯU Ý QUAN TRỌNG — Go KHÔNG tự nạp file .env. `envx` chỉ đọc os.Getenv, và
# trong k8s biến đến từ Secret/Deployment chứ không từ file. Để chạy local, dùng
# target Makefile đã source sẵn file này:
#
#   make run-orchestrator     # server
#   make smoke                # dbsmoke (cần DATABASE_URL + REDIS_URL)
#
# `go run ./cmd/orchestrator` trần sẽ KHÔNG thấy file này — đó là hành vi đúng,
# không phải bug.

# ============================================================ Data store

# Bắt buộc với `cmd/dbsmoke` (và với server từ P1, khi warm-pool + reaper thật sự
# đọc Redis). Server P0 chạy được mà không cần hai biến này — RequireDataStores()
# chỉ được gọi trên đường thật sự nối tới data store.
# Mật khẩu phải trùng .env ở root repo (file docker-compose.yml đọc).
DATABASE_URL=postgresql://dlp:MẬT-KHẨU@localhost:5432/dlp
REDIS_URL=redis://:MẬT-KHẨU@localhost:6379

# ============================================================ Địa chỉ lắng nghe

GRPC_ADDR=:9090
HTTP_ADDR=:8081

# ============================================================ Vận hành

LOG_LEVEL=info
SHUTDOWN_GRACE=15s

# ============================================================ Hai đồng hồ

# SESSION_TTL — idle deadline mặc định, GIA HẠN ĐƯỢC (ExtendSession, B5).
# HARD_CAP  — trần TUYỆT ĐỐI tính từ created_at, KHÔNG gia hạn được (D11).
#
# Hai con số này KHÁC NHAU về bản chất, không phải hai tên của một thứ: nhờ có
# HARD_CAP mà một client bị chiếm quyền spam heartbeat cũng chỉ giữ được pod tới
# trần cứng. Đặt SESSION_TTL > HARD_CAP là cấu hình mâu thuẫn — orchestrator từ
# chối khởi động thay vì âm thầm cắt mọi session xuống trần.
SESSION_TTL=1h
HARD_CAP=2h

# ============================================================ Warm-pool

# Số pod ấm giữ sẵn trong pool:free.
#
# ⛔ CÔNG THỨC PHẢI NHỚ (phase-1 D16):
#       trần session đồng thời = quota_hiệu_lực − POOL_TARGET
#
# Trên lab, quota hiệu lực ĐO ĐƯỢC là 4 pod (LimitRange defaultRequest
# 500m/512Mi × ResourceQuota requests 2100m/2112Mi). Nên POOL_TARGET=3 phục vụ
# đúng MỘT user rồi replenish chết vĩnh viễn vì quota; POOL_TARGET=1 phục vụ 3
# user mà pool vẫn luôn có sẵn một pod ấm để claim < 1s.
POOL_TARGET=1

# Image của pod sandbox.
#
# BẮT BUỘC, và KHÔNG còn default trong code (1.E-1). `pause` từng là mặc định
# cho tới khi có image thật, nhưng nó là fallback im lặng: pod lên Ready và
# claim thành công, rồi mới hỏng lúc gateway exec vào vì trong `pause` không có
# shell. Bỏ trống biến này ⇒ orchestrator TỪ CHỐI khởi động, đúng ý đồ.
#
# Trên cluster, Helm tự ghép `<image.registry>/dlp-sandbox-base:<image.tag>` khi
# `orchestrator.env.sandboxImage` để rỗng — không phải sửa code để đổi tag.
# Ở máy dev thì trỏ tag bạn vừa `docker build`.
SANDBOX_IMAGE=ghcr.io/nghaiz/dlp-sandbox-base:dev

# PHẢI khớp `sandbox.runtimeClassName` trong infra/helm/platform/values.yaml.
# Lệch một chữ thì ValidatingAdmissionPolicy từ chối MỌI pod, và triệu chứng là
# "warm-pool không bao giờ đầy" chứ không phải một lỗi trỏ về đây.
SANDBOX_RUNTIME_CLASS=sysbox-runc

# Khoảng đẩy thêm mỗi lần gateway heartbeat (D11).
#
# ⚠ CON SỐ NÀY THỰC TẾ QUYẾT ĐỊNH HẠN CỦA SESSION, không phải SESSION_TTL:
# công thức B5 là `expires_at = min(now + extend, created_at + HARD_CAP)`, nên
# ngay từ lần gia hạn ĐẦU TIÊN hạn sẽ bám theo biến này. SESSION_TTL chỉ là hạn
# cho tới heartbeat đầu.
EXTEND_DEFAULT=300s

# ============================================================ Reaper

# Nhịp sweep định kỳ. Sweep là ĐƯỜNG CHÍNH của reaper, không phải dự phòng:
# keyspace notification là best-effort, và mọi session hết hạn trong lúc reaper
# offline (deploy, crash) là mất pod vĩnh viễn nếu không có sweep.
REAP_INTERVAL=60s

# ============================================================ Auth gRPC

# mTLS của cổng gRPC — BA NẤC, dùng CHUNG một biến với gateway và apps/web
# (phase-1 1.C-4, đóng R25/B0′).
#
#   off        Không TLS. Cổng gRPC KHÔNG xác thực người gọi: `user_id` trong
#              mọi RPC là field client TỰ KHAI. Nhánh `system_component` của
#              ReapSession bị TỪ CHỐI (fail-closed) — reaper nội bộ không đi
#              qua gRPC nên không ảnh hưởng.
#   permissive Server có TLS, nhận cả client có cert lẫn không. Nấc để QUAN SÁT
#              ai đã cắm cert trước khi siết. KHÔNG khoan dung với cert SAI:
#              cert do CA lạ ký làm hỏng bắt tay ở tầng crypto/tls.
#   require    Không có client cert hợp lệ ⇒ Unauthenticated.
#
# Mặc định `off` ở đây là cho `go run` cục bộ (không có Secret nào để mount).
# Trên cụm, Helm đặt `permissive` rồi siết `require` — xem values.yaml
# platform.grpcMtlsMode.
GRPC_MTLS_MODE=off

# Cert/key/CA của cổng gRPC. Bắt buộc và phải ĐỌC ĐƯỢC khi GRPC_MTLS_MODE≠off —
# config.Load từ chối khởi động nếu thiếu, thay vì lên xanh rồi trả
# Unauthenticated cho 100% RPC.
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CA_FILE=

# Allowlist CommonName được dùng nhánh `actor.system_component` (ngăn bằng dấu
# phẩy). Bắt buộc khi GRPC_MTLS_MODE≠off.
#
# ⚠ RỖNG KHÔNG CÓ NGHĨA LÀ "CHO PHÉP TẤT CẢ" — nó là lỗi khởi động. CA của cụm
# ký cert cho CẢ apps/web LẪN gateway, nên "có cert hợp lệ" gộp hai consumer có
# quyền khác nhau vào một: không có allowlist thì apps/web reap được session của
# bất kỳ ai. Trên cụm, Helm đặt đúng một giá trị: "<release>-gateway".
GRPC_MTLS_SYSTEM_CNS=

# Namespace chạy pod sandbox của sinh viên. PHẢI khớp `sandbox.namespace` trong
# infra/helm/platform/values.yaml — đổi một chỗ mà quên chỗ kia là vỡ cô lập
# trong im lặng (orchestrator tạo pod vào namespace không có NetworkPolicy/quota).
SANDBOX_NAMESPACE=dlp-sandbox

# ============================================================ Debug

# Reflection phơi TOÀN BỘ API surface cho `grpcurl list` — tiện lúc dev, là do
# thám miễn phí ở prod. Chỉ bật khi đang debug.
GRPC_REFLECTION=false
