# Copy sang .env rồi điền giá trị thật. .env KHÔNG được commit.

# Bắt buộc với `go run ./cmd/dbsmoke` (và với server từ P1, khi nó thật sự đọc
# Redis). Server P0 chạy được không cần hai biến này.
DATABASE_URL=postgresql://dlp:MẬT-KHẨU@localhost:5432/dlp
REDIS_URL=redis://:MẬT-KHẨU@localhost:6379

# Tuỳ chọn (giá trị dưới đây là default).
GRPC_ADDR=:9090
HTTP_ADDR=:8081
LOG_LEVEL=info

# Reflection phơi toàn bộ API surface cho `grpcurl list`. Chỉ bật khi debug.
GRPC_REFLECTION=false
SESSION_TTL=1h
SHUTDOWN_GRACE=15s
SANDBOX_NAMESPACE=dlp-sandbox
