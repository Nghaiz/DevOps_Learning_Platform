# Copy sang .env rồi điền giá trị thật. .env KHÔNG được commit.

# Bắt buộc — không có default an toàn.
DATABASE_URL=postgresql://dlp:dlp_dev_only@localhost:5432/dlp
REDIS_URL=redis://localhost:6379

# Tuỳ chọn (giá trị dưới đây là default).
GRPC_ADDR=:9090
HTTP_ADDR=:8081
LOG_LEVEL=info
SESSION_TTL=1h
SHUTDOWN_GRACE=15s
SANDBOX_NAMESPACE=dlp-sandbox
