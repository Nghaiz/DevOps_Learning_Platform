# Script chạy trên Linux (host Sysbox) — BẮT BUỘC LF, kể cả khi checkout trên Windows.
# Có CRLF là bash báo '\r': command not found và cả script chết. Khoá về LF để dù
# edit trên Windows rồi scp sang VM, file vẫn luôn là LF.
*.sh   text eol=lf

# Script shell KHÔNG CÓ ĐUÔI — `*.sh` ở trên không phủ chúng. Đo bằng
# `git check-attr -a`: `entrypoint.sh` ra `eol: lf`, còn `bin/dlp-motd` chỉ ra
# `text: auto` (không luật eol nào). Nghĩa là checkout trên Windows cho CRLF, và
# một script CRLF trong container hỏng TỪNG DÒNG với `: command not found` —
# xa nhất có thể khỏi nguyên nhân. Cùng lý lẽ với `*.sh`, chỉ khác là phải gọi
# tên vì không có đuôi để khớp.
images/sandbox-base/bin/* text eol=lf

# Git hook cũng là script shell không đuôi, và cũng bị bỏ sót đúng như trên:
# `pre-push` ra `text: auto` ⇒ checkout trên Windows (core.autocrlf=true) cho
# CRLF. Thêm ở đây 2026-09-14, lúc gỡ khối tạm dừng trong hook — một hàng rào
# vừa bật lại mà file của nó có nguy cơ CRLF thì là hàng rào không đáng tin.
scripts/git-hooks/* text eol=lf

*.yaml text eol=lf
*.yml  text eol=lf

# Code sinh từ proto (buf) — drift gate (make proto-check) so sánh qua git
# status: buf trên Windows ghi CRLF, trên CI Linux ghi LF; không khoá LF thì
# cùng một nội dung bị coi là drift chỉ vì EOL (run 31245094744 đỏ đúng vụ này).
# Với eol=lf, git status so sánh SAU clean-filter nên khác biệt CRLF/LF vô hình.
proto/gen/** text eol=lf
packages/shared-types/gen/** text eol=lf

# .proto là INPUT của codegen — buf đọc byte thô. Windows checkout CRLF thì
# protoc-gen-es nhả '\r' của dòng comment trống thành trailing whitespace trong
# JSDoc ⇒ máy dev sinh ' * ' còn CI (LF) sinh ' *' — hai bản "cùng plugin cùng
# version" vẫn lệch byte, drift gate ping-pong không hội tụ (run 31245335779).
# Input giống hệt nhau ở mọi nền tảng thì output mới giống hệt nhau.
*.proto text eol=lf

# Script Lua được `go:embed` rồi gửi thẳng sang Redis. CRLF không làm Lua sai
# cú pháp, nhưng nó đổi nội dung ⇒ đổi SHA1 ⇒ máy dev Windows và CI Linux nạp
# HAI script khác nhau vào cache của cùng một Redis. Không hỏng, nhưng khiến
# việc đối chiếu `SCRIPT EXISTS <sha>` lúc chẩn đoán trở nên vô nghĩa.
*.lua text eol=lf

# Go: `gofmt` là một CỔNG CI, nên bản dev đọc phải giống hệt bản CI đọc. Với
# autocrlf trên Windows, working tree thành CRLF và `gofmt -l` báo MỌI file lệch
# — nhiễu đến mức không ai đọc nữa, rồi một lỗi format THẬT chìm trong đó và chỉ
# lộ khi CI đỏ (run 31308110663: căn lề struct tag + gofmt đổi '' thành ” theo
# quy tắc TeX-quote trong comment). Khoá LF thì `gofmt -l` local nói đúng sự thật.
*.go text eol=lf

# Nội dung của image sandbox: `COPY` thẳng vào một container Linux, nên CRLF ở
# đây là lỗi runtime chứ không phải chuyện thẩm mỹ. Ba file rc KHÔNG có đuôi
# (.zshrc/.bashrc/.tmux.conf) nên chúng rơi vào `* text=auto` bên dưới và với
# `core.autocrlf=true` thì working copy trên Windows thành CRLF — `docker build`
# chép đúng bản CRLF đó vào image.
#
# Hậu quả cụ thể: zsh đọc `.zshrc` có CRLF sẽ báo `$'\r': command not found` ở
# MỖI dòng lệnh, và tmux từ chối nạp `.tmux.conf` ⇒ mất `status off` (D17) nên
# `stty size` lệch 1 so với rows FE gửi. Cả hai chỉ hỏng trên máy dev Windows
# sau một lần checkout mới — CI (Linux) vẫn LF nên vẫn xanh, tức lỗi này KHÔNG
# có cổng nào bắt được. Cùng họ với ba sự cố EOL đã ghi ở trên.
images/sandbox-base/skel/**  text eol=lf
images/sandbox-base/etc/**   text eol=lf
**/Dockerfile                text eol=lf

# Nội dung FIRST-PARTY (dlp-*) của lab + playground. Khác `content/scenarios/**`
# bên dưới ở chỗ nó KHÔNG có upstream để so byte, nên `eol=lf` (chuẩn hoá) là
# đúng, không phải `-text` (giữ nguyên byte).
#
# Vì sao phải khoá: `parseContentBlocks` tách dòng bằng `split('\n')` và hai
# regex fence neo bằng `[ \t]*$`. Với CRLF, mỗi dòng còn một `\r` ở cuối nên
# KHÔNG fence nào khớp — hàm trả về một khối văn xuôi duy nhất và mọi nút
# `{{exec}}` biến mất, không lỗi, không cảnh báo. Với `core.autocrlf=true`, một
# lần clone trên Windows là đủ để `content-labs.test.ts` đỏ trên máy dev trong
# khi CI (Linux, LF) vẫn xanh — đúng họ với năm sự cố EOL đã ghi ở trên, và một
# lần nữa KHÔNG có cổng nào bắt được.
#
# Parser đã được vá để tự chuẩn hoá (đó mới là chỗ sửa thật, vì P9 cho markdown
# tới từ người soạn chứ không chỉ từ đĩa). Dòng này là lớp thứ hai: nó giữ cho
# cây làm việc trên mọi nền tảng giống nhau, nên một phép so byte hay một cổng
# đọc file không lệch giữa dev và CI.
content/labs/**        text eol=lf
content/playgrounds/** text eol=lf
content/paths/**       text eol=lf
content/quizzes/**     text eol=lf

# Mặc định: để git tự chuẩn hoá text, nhị phân giữ nguyên.
* text=auto

# Nội dung vendor từ upstream — bản sao BYTE-EXACT, KHÔNG chuẩn hoá gì cả.
#
# `-text` (không phải `text eol=lf`) vì đây là một tấm gương: thư mục chứa
# markdown, JSON, shell, .js và một PNG, còn cổng
# `node scripts/vendor-scenarios.mjs --check` so TỪNG BYTE với commit đã ghim.
# `eol=lf` vẫn cho git viết lại CRLF→LF lúc commit, nên một file upstream vốn
# CRLF sẽ được lưu sai; `-text` thì git không đụng vào byte nào.
#
# Vì sao nó phải nằm SAU `* text=auto` chứ không như các khối ở trên: trong
# .gitattributes **dòng khớp cuối cùng thắng**, và điều đó áp cho TỪNG attribute
# riêng. Các khối trên sống sót vì chúng đặt `eol`, thứ mà `* text=auto` không
# nhắc tới — còn `-text` thì tranh chấp trực tiếp với `text=auto` và sẽ THUA nếu
# đứng trước. Đặt nhầm chỗ thì dòng này im lặng vô hiệu, `git check-attr text`
# vẫn trả `auto`.
#
# Hậu quả nếu thiếu: với `core.autocrlf=true`, một lần `git clone` trên Windows
# biến mọi file text ở đây thành CRLF ⇒ `--check` báo LỆCH cả 4 scenario trên
# một cây vừa clone sạch, và lời khai license trong dlp.json ("nội dung này ĐÚNG
# là commit X") thành sai. CI (Linux) vẫn LF nên vẫn xanh — tức lỗi này KHÔNG có
# cổng nào bắt được, y hệt bốn sự cố EOL ở trên.
content/scenarios/** -text
