# Copy sang .env rồi điền giá trị thật. .env KHÔNG được commit (.gitignore đã chặn).

# Postgres — user/db khớp .env ở root (cái mà docker-compose.yml đọc).
# Mật khẩu phải trùng POSTGRES_PASSWORD trong .env root.
DATABASE_URL=postgresql://dlp:MẬT-KHẨU@localhost:5432/dlp

# Redis — mật khẩu phải trùng REDIS_PASSWORD trong .env root.
REDIS_URL=redis://:MẬT-KHẨU@localhost:6379

# Địa chỉ gRPC của services/orchestrator.
ORCHESTRATOR_GRPC_ADDR=localhost:9090

# === Better Auth (0.D) ===

# Secret ký session/JWT — tối thiểu 32 ký tự ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=đổi-cái-này-thành-chuỗi-ngẫu-nhiên-dài

# Origin công khai của app này — Better Auth dùng để build callback URL OAuth
# (vd http://localhost:3000/api/auth/callback/google) và làm issuer/audience mặc
# định của JWT plugin.
BETTER_AUTH_URL=http://localhost:3000

# OAuth Google — placeholder OK ở P0 (chỉ cần đi tới màn consent, chưa cần hoạt
# động thật). Lấy tại https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

# OAuth Microsoft (Entra ID) — placeholder OK ở P0. Lấy tại
# https://portal.azure.com (App registrations).
MICROSOFT_CLIENT_ID=placeholder-microsoft-client-id
MICROSOFT_CLIENT_SECRET=placeholder-microsoft-client-secret

# CORS allowlist (luật 2) — danh sách origin được phép, phân tách bằng dấu phẩy.
# KHÔNG dùng "*"; rỗng = không origin nào được phép (fail-closed).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit (luật 5) chỉ tin x-forwarded-for khi đứng SAU proxy tin cậy — bật
# '1' khi có Traefik (P3). Tắt (mặc định): middleware SKIP limit và log cảnh báo
# 1 lần — XFF là header client tự đặt được, tin bừa là bị né limit; còn dồn về
# bucket chung thì 1 client spam khoá được tất cả user khác.
# RATE_LIMIT_TRUST_PROXY=1
