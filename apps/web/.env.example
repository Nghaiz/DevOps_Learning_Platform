# Copy sang .env rồi điền giá trị thật. .env KHÔNG được commit (.gitignore đã chặn).

# Postgres — khớp docker-compose.yml ở root.
DATABASE_URL=postgresql://dlp:dlp_dev_only@localhost:5432/dlp

# Redis
REDIS_URL=redis://localhost:6379

# Địa chỉ gRPC của services/orchestrator (dùng từ P1 trở đi).
ORCHESTRATOR_GRPC_ADDR=localhost:9090
