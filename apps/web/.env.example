# apps/web — biến môi trường cho DEV LOCAL.
#
# Cách dùng:  cp apps/web/.env.example apps/web/.env  rồi điền giá trị thật.
# `.env` KHÔNG được commit (.gitignore đã chặn).
#
# Ai nạp file này:
#   next dev / next build            tự nạp
#   vitest                           vitest.setup.ts nạp thủ công (không ghi đè env thật)
#   db:generate/migrate/studio/smoke  node --env-file-if-exists=.env
#
# Giá trị phải lấy từ bên ngoài (Google, Azure) hoặc tự sinh: xem docs/env/README.md
#
# Mọi biến ACTIVE dưới đây đều phải có code đọc nó — cổng `pnpm env:check` bắt
# lệch. Biến để dạng "# TÊN=..." là khai OPTIONAL (chưa ai đọc, hoặc chỉ bật
# khi cần).

# ============================================================ App / URL

# Origin công khai của app. Dùng làm `metadataBase` (canonical + Open Graph) —
# thiếu thì Next cảnh báo và tự suy về localhost, làm mọi ảnh OG ở prod trỏ sai.
# Đây là biến SERVER-SIDE, đọc lúc chạy ⇒ đổi được qua Helm mà không build lại.
APP_URL=http://localhost:3000

# Port `next dev` / `next start` lắng nghe. Framework đọc trực tiếp, không có
# dòng code nào trong repo tham chiếu tên biến này.
# env-check: allow-unused
PORT=3000

# NODE_ENV: ĐỪNG đặt thủ công ở đây. Next tự đặt 'development' cho `next dev` và
# 'production' cho `next build`/`next start`; đặt đè là cách nhanh nhất để có một
# bản dev chạy code path production (và ngược lại — bản prod bật React devtools).
# Dockerfile đặt NODE_ENV=production cho image, đúng chỗ của nó.
# NODE_ENV=development

# Chỉ Docker build đặt biến này (apps/web/Dockerfile). Trên Windows dev, bước
# trace của `output: standalone` tạo symlink vào node_modules pnpm → EPERM.
# NEXT_OUTPUT=standalone

# NEXT_PUBLIC_* — CẢNH BÁO về vòng đời: Next NƯỚNG giá trị vào bundle LÚC BUILD,
# không đọc lúc chạy. Đặt nó trong Secret/Deployment của k8s là VÔ TÁC DỤNG —
# muốn đổi phải build lại image với `--build-arg`. Vì vậy P0 KHÔNG có biến
# NEXT_PUBLIC_ nào: mọi URL hiện tại đều same-origin. P1 (URL của WS gateway) là
# lúc đầu tiên thật sự cần, và sẽ đi qua build-arg — xem docs/env/README.md §5.
# NEXT_PUBLIC_GATEWAY_WS_URL=

# ============================================================ Database

# User/db khớp .env ở root (file mà docker-compose.yml đọc). Mật khẩu phải trùng
# POSTGRES_PASSWORD trong .env root, nếu không thì `pnpm db:migrate` báo 28P01.
DATABASE_URL=postgresql://dlp:MẬT-KHẨU@localhost:5432/dlp

# ============================================================ Redis

# Mật khẩu phải trùng REDIS_PASSWORD trong .env root.
REDIS_URL=redis://:MẬT-KHẨU@localhost:6379

# ============================================================ Security

# Secret ký session + JWT. Tối thiểu 32 byte ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Xem docs/env/01-generate-secrets.md. KHÔNG dùng lại giá trị này ở prod.
BETTER_AUTH_SECRET=đổi-cái-này-thành-chuỗi-ngẫu-nhiên-dài

# Origin Better Auth dùng để dựng callback URL OAuth
# (vd http://localhost:3000/api/auth/callback/google) và làm issuer/audience mặc
# định của JWT plugin. Phải khớp ĐÚNG redirect URI đã khai ở Google/Microsoft.
BETTER_AUTH_URL=http://localhost:3000

# Allowlist CORS (luật 2) — các origin được phép, phân tách bằng dấu phẩy.
# KHÔNG dùng "*". Rỗng = không origin nào được phép (fail-closed, cố ý).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit (luật 5) chỉ tin `x-forwarded-for` khi đứng SAU proxy tin cậy — đặt
# '1' khi có Traefik (P3). Tắt (mặc định): middleware SKIP limit và log cảnh báo
# một lần. XFF là header client tự đặt được, tin bừa là bị né limit; còn dồn về
# một bucket chung thì một client spam khoá được tất cả user khác.
# RATE_LIMIT_TRUST_PROXY=1

# ============================================================ OAuth

# Placeholder chạy được ở P0 — chỉ khi bấm "Đăng nhập với Google" mới cần giá trị
# thật. Lấy theo docs/env/02-google-oauth.md
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

# Lấy theo docs/env/03-microsoft-entra.md
MICROSOFT_CLIENT_ID=placeholder-microsoft-client-id
MICROSOFT_CLIENT_SECRET=placeholder-microsoft-client-secret

# ============================================================ Dịch vụ nội bộ

# Địa chỉ gRPC của services/orchestrator (host:port, KHÔNG có scheme).
# Trong k8s, Helm tự suy ra "<release>-orchestrator:9090".
ORCHESTRATOR_GRPC_ADDR=localhost:9090
