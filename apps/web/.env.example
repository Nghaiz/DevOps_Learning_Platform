# apps/web — biến môi trường cho DEV LOCAL.
#
# Cách dùng:  cp apps/web/.env.example apps/web/.env  rồi điền giá trị thật.
# `.env` KHÔNG được commit (.gitignore đã chặn).
#
# Ai nạp file này:
#   next dev / next build            tự nạp
#   vitest                           vitest.setup.ts nạp thủ công (không ghi đè env thật)
#   db:generate/migrate/studio/smoke  node --env-file-if-exists=.env
#
# Giá trị phải lấy từ bên ngoài (Google, Azure) hoặc tự sinh: xem docs/env/README.md
#
# Mọi biến ACTIVE dưới đây đều phải có code đọc nó — cổng `pnpm env:check` bắt
# lệch. Biến để dạng "# TÊN=..." là khai OPTIONAL (chưa ai đọc, hoặc chỉ bật
# khi cần).

# ============================================================ App / URL

# Origin công khai của app. Dùng làm `metadataBase` (canonical + Open Graph) —
# thiếu thì Next cảnh báo và tự suy về localhost, làm mọi ảnh OG ở prod trỏ sai.
# Đây là biến SERVER-SIDE, đọc lúc chạy ⇒ đổi được qua Helm mà không build lại.
APP_URL=http://localhost:3000

# Port `next dev` / `next start` lắng nghe. Framework đọc trực tiếp, không có
# dòng code nào trong repo tham chiếu tên biến này.
# env-check: allow-unused
PORT=3000

# NODE_ENV: ĐỪNG đặt thủ công ở đây. Next tự đặt 'development' cho `next dev` và
# 'production' cho `next build`/`next start`; đặt đè là cách nhanh nhất để có một
# bản dev chạy code path production (và ngược lại — bản prod bật React devtools).
# Dockerfile đặt NODE_ENV=production cho image, đúng chỗ của nó.
# NODE_ENV=development

# Chỉ Docker build đặt biến này (apps/web/Dockerfile). Trên Windows dev, bước
# trace của `output: standalone` tạo symlink vào node_modules pnpm → EPERM.
# NEXT_OUTPUT=standalone

# NEXT_PUBLIC_* — CẢNH BÁO về vòng đời: Next NƯỚNG giá trị vào bundle LÚC BUILD,
# không đọc lúc chạy. Đặt nó trong Secret/Deployment của k8s là VÔ TÁC DỤNG —
# muốn đổi phải build lại image với `--build-arg`. Vì vậy P0 KHÔNG có biến
# NEXT_PUBLIC_ nào: mọi URL hiện tại đều same-origin. P1 (URL của WS gateway) là
# lúc đầu tiên thật sự cần, và sẽ đi qua build-arg — xem docs/env/README.md §5.
# NEXT_PUBLIC_GATEWAY_WS_URL=

# ============================================================ Database

# User/db khớp .env ở root (file mà docker-compose.yml đọc). Mật khẩu phải trùng
# POSTGRES_PASSWORD trong .env root, nếu không thì `pnpm db:migrate` báo 28P01.
DATABASE_URL=postgresql://dlp:MẬT-KHẨU@localhost:5432/dlp

# ============================================================ Redis

# Mật khẩu phải trùng REDIS_PASSWORD trong .env root.
REDIS_URL=redis://:MẬT-KHẨU@localhost:6379

# ============================================================ Security

# Secret ký session + JWT. Tối thiểu 32 byte ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Xem docs/env/01-generate-secrets.md. KHÔNG dùng lại giá trị này ở prod.
BETTER_AUTH_SECRET=đổi-cái-này-thành-chuỗi-ngẫu-nhiên-dài

# Origin Better Auth dùng để dựng callback URL OAuth
# (vd http://localhost:3000/api/auth/callback/google) và làm issuer/audience mặc
# định của JWT plugin. Phải khớp ĐÚNG redirect URI đã khai ở Google/Microsoft.
BETTER_AUTH_URL=http://localhost:3000

# Allowlist CORS (luật 2) — các origin được phép, phân tách bằng dấu phẩy.
# KHÔNG dùng "*". Rỗng = không origin nào được phép (fail-closed, cố ý).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit (luật 5) chỉ tin `x-forwarded-for` khi đứng SAU proxy tin cậy — đặt
# '1' khi có Traefik (P3). Tắt (mặc định): middleware SKIP limit và log cảnh báo
# một lần. XFF là header client tự đặt được, tin bừa là bị né limit; còn dồn về
# một bucket chung thì một client spam khoá được tất cả user khác.
# RATE_LIMIT_TRUST_PROXY=1

# ============================================================ OAuth

# Placeholder chạy được ở P0 — chỉ khi bấm "Đăng nhập với Google" mới cần giá trị
# thật. Lấy theo docs/env/02-google-oauth.md
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret

# Lấy theo docs/env/03-microsoft-entra.md
MICROSOFT_CLIENT_ID=placeholder-microsoft-client-id
MICROSOFT_CLIENT_SECRET=placeholder-microsoft-client-secret

# ============================================================ Dịch vụ nội bộ

# Địa chỉ gRPC của services/orchestrator (host:port, KHÔNG có scheme).
# Trong k8s, Helm tự suy ra "<release>-orchestrator:9090".
ORCHESTRATOR_GRPC_ADDR=localhost:9090

# mTLS cho kênh gRPC tới orchestrator (phase-1 1.C-4). CÙNG một biến với hai
# service Go — xem services/orchestrator/.env.example để hiểu ba nấc.
#
# ⚠ SCHEME LÀ THỨ QUYẾT ĐỊNH, KHÔNG PHẢI CERT. connect-node dựng kênh h2c
# cleartext khi baseUrl là `http://` và BỎ QUA cert truyền vào — không lỗi,
# không cảnh báo. Vì thế orchestrator-client.ts suy scheme TỪ biến này, không
# viết tay ở hai chỗ. Giá trị lạ là lỗi, không rơi về `off`.
GRPC_MTLS_MODE=off
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CA_FILE=

# Tên khớp SAN trong cert của orchestrator. Bắt buộc khi mode≠off.
GRPC_TLS_SERVER_NAME=

# ============================================================ Lessons (P2)

# URL NỘI BỘ của terminal-gateway — BFF gọi `POST /exec/session/{id}` để chấm
# step (`lessons.checkStep`, 2.C).
#
# ⚠ KHÔNG phải APP_URL. Trình duyệt tới gateway qua proxy gộp origin (D1), BFF
# thì gọi thẳng. Trong k8s, Helm tự suy ra "<release>-gateway:8082".
GATEWAY_INTERNAL_URL=http://localhost:8082

# Thư mục nội dung bài học. Đường TƯƠNG ĐỐI theo cwd, và cwd khác nhau giữa hai
# môi trường: `next dev` / `vitest` chạy từ apps/web (giá trị dưới đây đúng),
# image standalone chạy từ /repo (Dockerfile đặt /repo/content/scenarios).
#
# Sai đường dẫn KHÔNG im lặng: loader ném ENOENT kèm đúng đường đã thử, thay vì
# hiện ra một trang /lessons trống rỗng.
SCENARIOS_DIR=../../content/scenarios

# ============================================================ Quản trị (P13)

# `/metrics` NỘI BỘ của orchestrator và gateway, đọc bởi `admin.health` (13.G).
# Chỉ admin gọi tới, và BFF gọi server-to-server — không đi qua trình duyệt.
#
# ⚠ RỖNG LÀ HỢP LỆ và có nghĩa "không có nguồn này", không phải "chưa cấu hình
# xong": `admin.health` phân biệt reached/ok, nên một nguồn không đặt URL hiện ra
# là `reached:false` kèm lý do, chứ không lặng lẽ đọc thành khoẻ mạnh.
#
# `GATEWAY_METRICS_URL` mặc định RỖNG một cách CỐ Ý: cổng admin 8083 của gateway
# không có trong `gateway-service.yaml`, và mở nó ra sẽ tạo một tên DNS ổn định
# tới `/metrics` KHÔNG xác thực cho mọi pod cùng namespace (netpol platform mặc
# định tắt). Đường đã dựng cho metric gateway là PodMonitor của namespace
# monitoring → đọc qua Prometheus. Xem P13 lane Go, mục 7.
ORCHESTRATOR_METRICS_URL=http://localhost:8081/metrics
GATEWAY_METRICS_URL=

# ================================================== Playwright / e2e (P13 13.H)

# Chỉ dùng khi chạy e2e. `next dev`, `next build`, và vitest KHÔNG đọc nhóm này —
# nhưng `scripts/env-check.mjs` quét mọi `process.env` trong package, kể cả
# `e2e/**`, nên chúng phải được khai ở đây hoặc cổng "Env drift" của job `ts` đỏ
# và `ci-ok` không bao giờ xanh.

# Tài khoản e2e. RỖNG là đường mặc định: fixture tự đăng ký một tài khoản mới mỗi
# lượt qua `/api/auth/sign-up/email` (khuôn 2.D). Chỉ đặt khi cần chạy lại trên
# một tài khoản đã có.
E2E_EMAIL=
E2E_PASSWORD=

# HAI CỜ NGHIỆM THU — cùng một cái bẫy, hai trục khác nhau. Không đặt thì test
# tự `skip`, và một lượt toàn SKIP trông y hệt một lượt toàn PASS trong báo cáo.
# Ở lượt nghiệm thu đợt 3 phải đặt CẢ HAI:
#
#   E2E_REQUIRE_ROLES=1    năm màn quản trị + soạn bài cần vai trò author/admin,
#                          chỉ đến từ SQL qua `e2e/scripts/promote-role.sh`.
#   E2E_REQUIRE_SESSION=1  ba ô D10 (Esc-Esc rời terminal) cần một phiên sandbox
#                          THẬT, nên chúng skip ở mọi nơi không có orchestrator.
E2E_REQUIRE_ROLES=
E2E_REQUIRE_SESSION=

# `1` = Playwright tự dựng `next start` cục bộ (job `web-a11y` của CI dùng đường
# này). Rỗng = trỏ thẳng vào cụm qua `E2E_BASE_URL`.
E2E_START_SERVER=

# Declare both when measuring a local build; the harness banner records them.
E2E_BASE_URL=http://localhost:3000
# E2E_ORIGIN=http://localhost:3000
# Optional real local gateway. Enables the same-origin test ingress on :3000,
# with Next on E2E_NEXT_PORT and /ws/session + /ide/session forwarded here.
E2E_GATEWAY_URL=
E2E_NEXT_PORT=3001
# Optional Mailpit HTTP inbox for the real password reset browser flow.
E2E_MAILPIT_URL=

# GitHub Actions tự đặt `CI=true`. Khai ở đây vì `playwright.config.ts` đọc nó để
# bật `forbidOnly` + `retries`; không khai thì env-check đỏ.
CI=

# ============================================================ Password reset SMTP

# `docker compose --profile mail up -d mailpit` starts a local inbox at :8025.
# No SMTP relay: local mail stays on this machine. Production uses a provider
# host with SMTP_TLS=starttls (587) or implicit (465), and its credentials.
# Leave SMTP_HOST/SMTP_FROM empty to explicitly disable password reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
