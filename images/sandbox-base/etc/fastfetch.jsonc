{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Logo là ANSI ART trong repo, KHÔNG phải ảnh. Xem etc/ptit.ansi + README
  // § "Logo PTIT" để biết vì sao không đi đường sixel.
  //
  // `file-raw` chứ không `file`: nội dung đã mang sẵn escape 24-bit của chính
  // nó, và `file` sẽ diễn giải lại chuỗi màu (thay `$1`..`$9` theo bảng màu
  // fastfetch) — tức bảng màu của dlp.omp.json bị một tầng thứ hai ghi đè.
  // `file-raw` in đúng byte trong file.
  //
  // `width`/`height` phải khai TAY cho `*-raw`: fastfetch không phân tích nội
  // dung raw nên nó không đoán được kích thước, và thiếu hai số này thì mọi
  // dòng thông tin bên phải in đè lên logo. 34 cột là bề rộng ĐO ĐƯỢC của
  // ptit.ansi (dòng dài nhất: "Học viện CN Bưu chính Viễn thông" + 2 space);
  // 16 là số dòng. Sửa logo thì sửa cả hai số này.
  "logo": {
    "type": "file-raw",
    "source": "/etc/dlp/ptit.ansi",
    "width": 34,
    "height": 16,
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": "  "
  },

  // Chỉ những gì có ích trong một pod lab. CỐ Ý BỎ:
  //   · Host/Board/BIOS  — trong container là thông số của NODE, không phải của
  //     phiên. In ra là dạy sai về ranh giới cách ly.
  //   · GPU/Display/DE/WM/Theme/Icons — không tồn tại ở đây.
  //   · LocalIp/PublicIp — sandbox nằm dưới NetworkPolicy deny-all; PublicIp
  //     sẽ TREO tới khi timeout (module đó gọi ra internet), làm màn chào đứng
  //     hình vài giây ngay đầu mỗi phiên. Đây là bẫy đắt nhất trong danh sách.
  "modules": [
    { "type": "title", "format": "{user-name} @ sandbox" },
    "separator",
    { "type": "os", "key": "Hệ điều hành" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "cpu", "key": "CPU" },
    { "type": "memory", "key": "RAM" },
    // ⚠ NHÃN "Máy đã chạy" CÓ CHỦ Ý. Bản đầu ghi "Pod chạy được" và đó là một
    // KHẲNG ĐỊNH CHƯA ĐO: module này đọc /proc/uptime, mà trong container thường
    // đó là uptime của KERNEL/node, không phải tuổi pod (đo 2026-09-07 bằng
    // `docker run` thường: hiện 9 giờ, đúng bằng tuổi máy chủ). Sysbox có ảo hoá
    // một phần procfs, nên trên cụm lab con số này CÓ THỂ đúng là tuổi pod —
    // nhưng chưa ai đo, nên đừng dán nhãn như thể đã biết.
    // ⛔ Và trong mọi trường hợp nó KHÔNG phải tuổi PHIÊN HỌC: pod đến từ warm
    // pool, tức nó đã sống trước khi sinh viên claim. Tuổi phiên là dòng
    // "Phiên" bên dưới.
    { "type": "uptime", "key": "Máy đã chạy" },
    { "type": "shell", "key": "Shell" },

    // Hai dòng dưới gọi ngược lại dlp-motd. `--field` là một nhánh RIÊNG, không
    // đi qua cờ một-lần, nên không có đệ quy.
    //
    // Module `command` với output RỖNG thì fastfetch bỏ hẳn dòng đó — nên khi
    // chưa ai ghi /run/dlp/session-deadline, dòng "Phiên" biến mất thay vì hiện
    // một giá trị bịa. Cùng cơ chế cho "Công cụ" khi bài không bật gì.
    { "type": "command", "key": "Phiên", "text": "dlp-motd --field session" },
    { "type": "command", "key": "Công cụ", "text": "dlp-motd --field tools" },

    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
