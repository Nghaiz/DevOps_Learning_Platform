{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",

  "//": "globalDependencies: turbo chỉ hash file TRONG package + lockfile + root package.json. Thiếu mấy dòng dưới thì sửa tsconfig.base.json (bật/tắt strict, đổi target) hay eslint.config.mjs root sẽ cho `turbo run build test` trả CACHED, XANH — không hề typecheck lại. Ở CI đó là cái xanh giả. || tasks.test.env: turbo mặc định envMode STRICT — biến không khai bị LỘT khỏi process con; CI đặt env ở job level, thiếu danh sách đó thì vitest trong CI không thấy DATABASE_URL (local thoát nạn nhờ apps/web/.env nên lỗi chỉ lộ ở CI). turbo cấm key '//' trong task object nên ghi chú nằm ở đây.",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    ".prettierignore",
    "docs/redis-key-vectors.json"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NEXT_OUTPUT đổi hình dạng output (standalone hay không) — không khai ở đây
      // thì turbo trả CACHED của lần build với giá trị env khác. APP_URL cùng lý
      // do: layout.tsx đọc nó ở module scope, tức lúc build sinh metadata tĩnh.
      "env": ["NEXT_OUTPUT", "APP_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      // "build" của CHÍNH package phải chạy trước: next build sinh .next/types
      // (route types) mà next-env.d.ts (Next 16, gitignored) import — thiếu thì
      // tsc chạy trên program thiếu generated types, xanh/đỏ tuỳ thứ tự task
      // trong cùng lần `turbo run`. Với ui/shared-types build==typecheck nên
      // dependency này gần như miễn phí.
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "CORS_ALLOWED_ORIGINS",
        "GRPC_MTLS_MODE",
        "GRPC_TLS_CERT_FILE",
        "GRPC_TLS_KEY_FILE",
        "GRPC_TLS_CA_FILE",
        "GRPC_TLS_SERVER_NAME",
        "ORCHESTRATOR_METRICS_URL",
        "GATEWAY_METRICS_URL"
      ]
    },
    "e2e": {
      // ⛔ "cache": false LÀ ĐIỂM CHÍNH CỦA TASK NÀY, không phải một tinh chỉnh.
      //
      // turbo hash theo NỘI DUNG FILE TRONG PACKAGE. Một lượt e2e không đo file
      // — nó đo một server ĐANG CHẠY ở đầu kia của E2E_BASE_URL: một cụm k8s,
      // một image đã side-load, một DB có state. Không byte nào trong repo thay
      // đổi khi cụm hỏng. Để turbo cache task này nghĩa là lượt thứ hai trả
      // FULL TURBO, XANH, trong khi cụm có thể đã sập từ lâu — một lời khẳng
      // định về hạ tầng mà ta chưa hề chạm vào ở lượt đó.
      //
      // Cùng lớp lỗi với chú thích globalDependencies ở trên, nhưng tệ hơn: ở
      // đó cache nói dối về mã nguồn (thứ turbo ÍT NHẤT hash được), ở đây nó
      // nói dối về một thứ nằm ngoài tầm hash hoàn toàn.
      "cache": false,
      "dependsOn": ["^build"],
      // envMode STRICT lột mọi biến không khai. Hai nhóm:
      //   1. E2E_* — hợp đồng D11 (apps/web/e2e/env.ts).
      //   2. phần còn lại — CHỈ cần khi E2E_START_SERVER=1, vì lúc đó Playwright
      //      tự spawn `next start` và tiến trình con đó đọc trọn env của app.
      //      Thiếu chúng thì server lên được rồi chết ở request đầu tiên, và
      //      triệu chứng là "spec timeout" chứ không phải "thiếu env".
      "env": [
        "E2E_BASE_URL",
        "E2E_ORIGIN",
        "E2E_EMAIL",
        "E2E_PASSWORD",
        "E2E_START_SERVER",
        "E2E_REQUIRE_ROLES",
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "APP_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "CORS_ALLOWED_ORIGINS",
        "GRPC_MTLS_MODE",
        "GRPC_TLS_CERT_FILE",
        "GRPC_TLS_KEY_FILE",
        "GRPC_TLS_CA_FILE",
        "GRPC_TLS_SERVER_NAME",
        "ORCHESTRATOR_METRICS_URL",
        "GATEWAY_METRICS_URL"
      ]
    }
  }
}
