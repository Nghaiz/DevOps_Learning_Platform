# ============================================================================
#  KHÔNG PHẢI SECRET. File này CÓ commit vào git — cố ý.
# ============================================================================
#
# Đây là credential GIẢ, chỉ tồn tại trong runner GitHub Actions và trong lần
# `make test-ci` ở máy bạn. Container Postgres/Redis mà chúng mở khoá bị xoá cùng
# runner sau vài phút, không nghe ra internet, và không chứa dữ liệu của ai.
#
# VÌ SAO CÓ FILE NÀY: trước đây cùng những giá trị này nằm inline trong
# .github/workflows/ci.yml. Chúng phải khớp với `services:` của workflow, với
# lệnh `docker run` khởi động Redis, và với danh sách turbo.json tasks.test.env —
# bốn chỗ, không chỗ nào ép chỗ nào. Gom về một file để CI đọc một lần vào
# $GITHUB_ENV, và để dev tái tạo CHÍNH XÁC môi trường CI ở máy mình (`make
# test-ci`) khi test đỏ trên runner mà xanh ở local.
#
# VÌ SAO TÊN LÀ `.github/ci.env`, KHÔNG PHẢI `.env.ci`: hook `secret-guard` chặn
# cứng `git add` mọi file khớp `.env.*`. Đó là luật đáng giữ nguyên vẹn — nới nó
# ra cho một ngoại lệ "lần này an toàn" là mở đúng cái cửa mà lần sau một `.env`
# thật đi qua. File nằm ngoài namespace đó, và cạnh chính cấu hình CI dùng nó.
#
# Cổng `pnpm env:check` bắt buộc file này chứa MỌI biến mà code gọi requireEnv().
#
# ĐỪNG thêm secret thật vào đây. Secret thật đi qua GitHub Actions secrets
# (docs/env/04-github-repo-settings.md) — gitleaks quét file này như mọi file khác.

# ============================================================ Data store
# Khớp với `services: postgres:` và bước `docker run ... redis` trong ci.yml.
DATABASE_URL=postgresql://dlp:ci-only-password@localhost:5432/dlp
REDIS_URL=redis://:ci-only-password@localhost:6379

POSTGRES_USER=dlp
POSTGRES_PASSWORD=ci-only-password
POSTGRES_DB=dlp
REDIS_PASSWORD=ci-only-password

# ============================================================ App / Security
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=ci-only-secret-khong-dung-o-bat-ky-dau-khac
BETTER_AUTH_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================ terminal-gateway
# Gateway verify sandbox token bằng JWKS của Better Auth (phase-1 D15). Trên
# runner, web chạy ở localhost:3000 khi test e2e cần nó.
GATEWAY_JWKS_URL=http://localhost:3000/api/auth/jwks

# `iss` bắt buộc của sandbox token — khớp BETTER_AUTH_URL ở trên. KHÔNG suy ra
# được từ GATEWAY_JWKS_URL (cái đó là DNS in-cluster trên k8s, đây là URL công khai).
GATEWAY_TOKEN_ISSUER=http://localhost:3000

# Allowlist Origin của handshake WS — lớp duy nhất đóng CSWSH.
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# Trần WS đồng thời trên một session (D17). Xem services/terminal-gateway/.env.example.
GATEWAY_MAX_WS_PER_SESSION=1

# Lệnh exec — hằng số phía server (contract §3c). tmux là cơ chế reconnect (D3).
GATEWAY_EXEC_COMMAND=tmux new-session -A -s dlp

# Trần MỘT lượt chấm — 120s, không phải 30s (30s chọn lúc cụm rảnh và đã ĐO là
# sai dưới tải: 17/18 người nhận 500 dù build đúng). Đặt ở đây cho đủ ma trận 4
# chỗ mà chính file này sinh ra để giữ: code ↔ .env.example ↔ Helm ↔ CI.
#
# ⚠ Trung thực về việc dòng này gác được gì: nó là TÀI LIỆU, không phải phép đo.
# File này chỉ được nạp vào job `ts` (ci.yml, bước 'Nạp .github/ci.env') và vào
# `make test-ci` — job `go` KHÔNG nạp nó, và không mã TS nào đọc biến này. Thứ
# thật sự gác giá trị vẫn là default trong `internal/config/config.go` cùng test
# của nó. Đừng đọc sự có mặt ở đây thành 'CI đang kiểm 120s'.
GATEWAY_EXEC_TIMEOUT=120s

# ============================================================ mTLS gRPC (1.C-4)

# `off` trên CI: không có Secret nào để mount, và chặng test không dựng cụm.
# Đường mTLS được phủ bằng test Go bắt tay THẬT với cert sinh trong test —
# xem services/shared/tlsx và internal/grpcserver, không phụ thuộc bốn biến dưới.
GRPC_MTLS_MODE=off

# Rỗng là ĐÚNG khi mode=off. Chúng phải có mặt vì env.ts gọi requireEnv() cho cả
# bốn, và turbo (envMode STRICT) lột mọi biến không khai — thiếu một cái là
# vitest đỏ trên runner với lỗi trỏ về env, không về code đang sửa.
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CA_FILE=
GRPC_TLS_SERVER_NAME=

# ============================================================ OAuth
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
MICROSOFT_CLIENT_ID=placeholder
MICROSOFT_CLIENT_SECRET=placeholder

# ============================================================ Quản trị (P13)
# `admin.health` đọc hai URL này. Rỗng là hợp lệ (nguồn hiện ra reached:false
# kèm lý do); test không gọi mạng thật, nhưng turbo envMode STRICT lột mọi biến
# không khai nên thiếu một cái là vitest đỏ trên runner.
ORCHESTRATOR_METRICS_URL=
GATEWAY_METRICS_URL=
