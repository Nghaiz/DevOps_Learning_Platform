# Credential cho docker-compose.yml (Postgres + Redis dev).
# Copy sang .env rồi đổi giá trị. .env KHÔNG được commit.
#
# compose dùng `${VAR:?}` cho hai mật khẩu dưới đây — thiếu là `docker compose up`
# dừng ngay, thay vì im lặng chạy bằng mật khẩu nằm sẵn trong git.

POSTGRES_USER=dlp
POSTGRES_PASSWORD=đổi-cái-này
POSTGRES_DB=dlp
POSTGRES_PORT=5432

REDIS_PASSWORD=đổi-cái-này-nữa
REDIS_PORT=6379

# Chỉ đổi khi THẬT SỰ cần cho máy khác truy cập (mặc định chỉ localhost).
# POSTGRES_HOST=0.0.0.0
# REDIS_HOST=0.0.0.0
